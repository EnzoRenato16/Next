# ---------------------------------------------------------------------------
# EXEMPLO — copie para config/camera.env e preencha. NUNCA versione o real.
#
#   cp config/camera.env.example config/camera.env
#   chmod 600 config/camera.env
#   source config/camera.env
#
# A senha NAO pode ficar no codigo (regra do roteiro). Fica so aqui.
# ---------------------------------------------------------------------------

# Opcao A: URL RTSP completa (recomendado pelo roteiro)
export CAMERA_RTSP='rtsp://USUARIO:SENHA@192.168.50.108:554/cam/realmonitor?channel=1&subtype=1'
#   obs: se a senha tiver @, troque por %40 na URL (ex.: senha "a@b" vira "a%40b")

# Opcao B: partes separadas (o config.py monta a URL se CAMERA_RTSP nao existir)
# export CAMERA_IP='192.168.50.108'
# export CAMERA_PORT='554'
# export CAMERA_USER='USUARIO'
# export CAMERA_PASS='SENHA'
# export CAMERA_SUBTYPE='1'      # 1 = sub-stream (mais leve); 0 = principal (4K, pesado)

export ROOM_ID='SALA_01'
export CAMERA_ID='CAM_01'
export GROUP_ID='grupo11'

# Ajustes de desempenho no AIBOX (opcionais)
# export DETECT_EVERY='3'        # roda o detector 1x a cada N frames
# export PRESENCE_MIN_HITS='5'   # frames p/ confirmar presenca
# export COSINE_THRESHOLD='0.363'
