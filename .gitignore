# Credenciais e segredos — NUNCA versionar
.env
.env.*
!.env.example
daten/config/camera.env

# Bancos locais (o servidor cai pra SQLite sozinho quando o Postgres não responde)
*.db
*.sqlite
*.sqlite3

# Dados sensíveis do EduVision (fotos e biometria dos alunos, nunca sobem)
daten/data/
daten/logs/

# Os modelos do OpenCV Zoo em daten/models/ SOBEM para o git, de proposito.
# A regra antiga aqui era "daten/models/*.onnx" (baixe localmente), e ela
# barrou os arquivos EM SILENCIO: o git add pulou, o commit dizia que os
# modelos iam versionados, e o --rosto so ia falhar no laboratorio, sem
# internet para baixar. Conferir sempre com:  git ls-files daten/models

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Cache de ferramentas (regenerável, não precisa versionar)
graphify-out/cache/

# Sistema operacional
.DS_Store
Thumbs.db


# treino
treino/__pycache__/

# Ponte da câmera IP: contém a senha da câmera
go2rtc.yaml
go2rtc.exe
go2rtc

# Amostras gravadas da câmera de casa: dados de ambiente privado
treino/local/

# A chave que protege os cadastros. NUNCA vai para o git: ela mora ao lado do
# banco justamente para nao estar dentro dele.
chave-bio.txt
